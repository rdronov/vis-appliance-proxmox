# Run scripts/deploy_vis_proxmox.sh on a Proxmox VE node after copying this
# file to a private location and replacing the environment-specific values.

TEMPLATE_VMID=9100
VM_ID=120
VM_NAME=vis-lab

# Leave TARGET_STORAGE empty to keep the template's storage placement.
TARGET_STORAGE=local-lvm
FULL_CLONE=true
START_VM=true
ONBOOT=true

# Proxmox Cloud-Init networking. IPv4 CIDR is required for this appliance.
VIS_FQDN=vis.vcf.lab
VIS_IP_CIDR=172.30.0.9/24
VIS_GATEWAY=172.30.0.1
VIS_DNS_SERVERS="192.168.30.29"
VIS_SEARCH_DOMAIN=vcf.lab
VIS_NTP_SERVER=pool.ntp.org

# The template contains this unprivileged sudo user. Use a public key whenever
# possible. VIS_OS_PASSWORD is optional and has no repository default.
VIS_OS_USER=visadmin
VIS_SSH_PUBLIC_KEY_FILE=/root/.ssh/id_ed25519.pub
VIS_OS_PASSWORD=

# VIS UI credentials are required. Set the password only in your private copy.
VIS_ADMIN_USERNAME=admin
VIS_ADMIN_PASSWORD=

# Must not overlap the management or VCF networks.
VIS_POD_CIDR_NETWORK=10.10.0.0/16

# A directory-backed Proxmox storage with snippets enabled is required.
SNIPPET_STORAGE=local
SNIPPET_DIR=/var/lib/vz/snippets
KEEP_VENDOR_SNIPPET=false
